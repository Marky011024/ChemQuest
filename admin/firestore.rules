rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    // No client can create its own administrator privileges.
    // Add the first authorized admin manually using Firebase Console.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /questionBank/{questionId} {
      // Only admin accounts can edit or publish. Unity should later read
      // published VERSION SNAPSHOTS from a distinct read-only collection,
      // rather than exposing drafts/answer keys to student clients.
      allow read, create, update, delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
